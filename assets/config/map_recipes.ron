RecipeFile(
    // Spawn lists that recipes include with `presets: [...]`, ahead of their own spawns.
    spawn_presets: {
        "LeftToRight": [
            (what: PlayerStart, at: Edge(Left)),
            (what: Exit, at: Edge(Right)),
        ],
        "BottomToTop": [
            (what: PlayerStart, at: Edge(Bottom)),
            (what: Exit, at: Edge(Top)),
        ],
    },
    defaults: (
        size_x_range: (50, 100),
        size_y_range: (50, 100),
        floor: Ground,
        structures: [],
        // No enemy spawns within this many tiles of the player start.
        start_clearance: 10,
        // A recipe's own `presets` or `spawns` replace these entirely.
        presets: ["LeftToRight"],
        spawns: [
            (what: RandomEnemy, count: (10, 15), at: Random(x_deciles: (2, 8)), separation: 5),
        ],
    ),
    structures: {
        "HubTown": (
            floor: Cobblestone,
            glyphs: [
                "#########################",
                "#########################",
                "##ccccccccccXcccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##cccccccccccccccSccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##cccccHcccccccccTccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccPcccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##ccccccccccccccccccccc##",
                "##########wwwww##########",
                "##########wwwww##########",
                ",,,,,,,,,,wwwww,,,,,,,,,,",
                ",,,,,,,,,,wwwww,,,,,,,,,,",
                ",,,,,,,,,,wwwww,,,,,,,,,,",
                ",,,,,,,,,,wwwww,,,,,,,,,,",
                ",,,,,,,,,,wwwww,,,,,,,,,,",
            ],
        ),
        "Temple": (
            floor: Cobblestone,
            glyphs: [
                "#######",
                "#wcccw#",
                "#wcccw#",
                "#wcCcw#",
                "#wcccw#",
                "#wcccw#",
                "##www##",
            ],
        ),
    },
    hub: (
        name: "HubTown",
        size: 60,
        floor: Grass,
        structures: [
            (kind: Structure("HubTown"), at: CenterOffset((0, -3))),
            (kind: Pond(size: Exact((14, 9)), shape: Blob), at: MapMin((42, 4))),
        ],
        // The town's P and X glyphs provide the start and the exit.
        presets: [],
        spawns: [],
    ),
    dungeons: [
        (
            name: "Swamp",
            weight: 40,
            structures: [
                (kind: Structure("Temple")),
                (kind: EmptySquare()),
                (kind: Pond(size: Ranged((5, 3), (12, 8)), shape: Blob)),
                (kind: Rubble(), count: 3),
            ],
        ),
        (
            name: "SwampWithALotOfEmptySquares",
            weight: 25,
            structures: [
                (kind: Structure("Temple")),
                (kind: EmptySquare(), count: 5),
            ],
        ),
        (
            name: "LongHallway",
            weight: 25,
            size_x_range: (100, 200),
            size_y_range: (15, 35),
            floor: Cobblestone,
            structures: [],
        ),
        (
            name: "TreasureRoom",
            weight: 10,
            size: 50,
            floor: Cobblestone,
            structures: [(kind: Structure("Temple"), at: Center)],
            spawns: [(what: Chest, count: (10, 15), at: Random())],
        ),
        (
            name: "FireShrine",
            weight: 10,
            size: 60,
            floor: Cobblestone,
            structures: [(kind: Structure("Temple"), name: "Temple", at: Center)],
            spawns: [
                (what: Enemy(FireMage), at: MapMin((5, 5))),
                (what: Enemy(FireMage), at: MapMax((-6, -6))),
                (what: RandomEnemy, count: (5, 10), at: Near(structure: "Temple", radius: 10)),
            ],
        ),
        (
            name: "SkyTempleAscent",
            weight: 15,
            size_x_range: (40, 60),
            size_y_range: (80, 120),
            floor: Ground,
            presets: ["BottomToTop"],
            spawns: [
                (
                    what: RandomEnemy,
                    count: (8, 12),
                    at: Near(structure: "SummitTemple", radius: 12),
                    separation: 4,
                ),
                (what: Chest, count: (3, 5), at: Random()),
            ],
            structures: [
                (kind: Structure("Temple"), name: "SummitTemple", at: CenterOffset((0, 20))),
                (
                    kind: Structure("Temple"),
                    name: "LowerTemple",
                    at: Near(structure: "SummitTemple", offset: (0, -30), radius: 6),
                ),
                (kind: EmptySquare(), count: 2),
                (kind: Rubble(), count: 4),
            ],
        ),
    ],
    arenas: [],
)
